# API image: Cloud Run service, CPU only. Built by deploy.sh (context = repo root).
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PORT=8080 MODE=gcp
WORKDIR /app
COPY backend/requirements.txt ./
# numpy + pandas: used by fovea's output-format validation
RUN pip install -r requirements.txt numpy pandas

COPY fovea/ fovea/
COPY backend/ backend/
CMD exec uvicorn backend.api:app --host 0.0.0.0 --port ${PORT} --workers 2
