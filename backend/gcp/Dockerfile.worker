# GPU worker image: one Cloud Run Job, NVIDIA L4. Built by deploy.sh (context = repo root).
# The NVIDIA driver comes from Cloud Run; PyTorch wheels bring their own CUDA libraries.
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility,video \
    FOVEA_WEIGHTS_DIR=/opt/weights \
    TORCH_HOME=/opt/torch \
    HF_HOME=/opt/hf \
    YOLO_CONFIG_DIR=/tmp/ultralytics \
    MODE=gcp

# ffmpeg (Ubuntu's build supports NVENC/NVDEC) + OpenCV runtime libraries
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-venv python3-pip ffmpeg libgl1 libglib2.0-0 ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH

WORKDIR /app
COPY requirements.txt ./requirements-fovea.txt
COPY backend/requirements.txt ./requirements-backend.txt
RUN pip install -r requirements-fovea.txt -r requirements-backend.txt

# Bake all model weights into the image (from your Hugging Face repo) so tasks start fast.
COPY pyproject.toml ./
COPY fovea/ fovea/
ARG HF_REPO=""
RUN FOVEA_HF_REPO="${HF_REPO}" python -m fovea download --all

COPY backend/ backend/
ENTRYPOINT ["python", "-m", "backend", "worker"]
