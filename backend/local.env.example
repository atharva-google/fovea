# Settings for running the backend on your own machine.
#   python -m backend serve --env backend/local.env
# Every line is optional; these are the defaults.

MODE=local
DATA_DIR=./data                 # uploads, job folders and job records live here
PORT=8000
PUBLIC_URL=http://localhost:8000   # how the browser reaches this backend (used in upload/download links)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000   # where your frontend runs

AUTH_MODE=none                  # none | api_key  (use api_key if other machines can reach this backend)
API_KEY=

DEMO_MODE=false                 # true = enforce the upload/duration/daily limits below
MAX_UPLOAD_MB=500
MAX_DURATION_S=300
DAILY_JOBS_PER_USER=3
MAX_CONCURRENT_JOBS=1           # jobs processed at the same time on this machine
